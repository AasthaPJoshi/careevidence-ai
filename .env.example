# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.
# Same variable names are used in local dev and in the production-style
# deployment later; only the values (host, passwords) change.

PGHOST=localhost
PGPORT=5432
PGDATABASE=careevidence

# Role passwords — local dev values only. Generate real random values,
# e.g. `openssl rand -base64 24`, and never reuse these across roles.
CAREEVIDENCE_ETL_PASSWORD=changeme_etl
CAREEVIDENCE_ANALYST_PASSWORD=changeme_analyst
CAREEVIDENCE_APP_PASSWORD=changeme_app
CAREEVIDENCE_API_PASSWORD=changeme_api
